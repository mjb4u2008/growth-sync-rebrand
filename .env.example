# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Optional: demo scheduler URL. The app checks multiple names and will also fall back
# to a Vercel serverless function so you can keep this as a regular server-side env var.
NEXT_PUBLIC_SCHEDULER_URL="https://calendly.com/your-team/intro-call"
VITE_CALENDLY_URL="https://calendly.com/your-team/intro-call"
CALENDLY_URL="https://calendly.com/your-team/intro-call"

# Optional server-side database capture for /book-a-call.
# SUPABASE_SERVICE_ROLE_KEY must only be used by api/leads.ts, never client-side.
# Preferred: SUPABASE_SERVICE_ROLE_KEY. Fallback: SUPABASE_PUBLISHABLE_KEY or SUPABASE_ANON_KEY
# with the insert-only RLS policy in supabase/migrations.
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="YOUR_SUPABASE_SERVICE_ROLE_KEY"
SUPABASE_PUBLISHABLE_KEY="YOUR_SUPABASE_PUBLISHABLE_KEY"
SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"

# Optional lead capture notification destinations for /book-a-call.
# Configure Supabase, a webhook, or Resend in Vercel for production lead capture.
GROWTHSYNC_LEAD_WEBHOOK_URL="https://your-crm-or-slack-webhook.example/leads"
LEAD_WEBHOOK_URL="https://your-crm-webhook.example/leads"
SLACK_WEBHOOK_URL="https://hooks.slack.com/services/..."
RESEND_API_KEY="re_..."
LEAD_NOTIFICATION_EMAIL="hello@growthsync.com"
LEAD_NOTIFICATION_FROM="GrowthSync <leads@growthsync.com>"

# Optional: overrides the Formspree endpoint that /socialcommercesummit leads
# also submit to. Defaults to the Social Commerce Summit form if unset.
SOCIAL_COMMERCE_SUMMIT_FORMSPREE_ENDPOINT="https://formspree.io/f/xvzezgdr"

# Optional paid-media browser measurement. These public Vite values enable
# browser-side Google/Meta page views and lead conversion events.
VITE_GOOGLE_TAG_ID="AW-1234567890"
VITE_GOOGLE_ADS_CONVERSION_ID="AW-1234567890"
VITE_GOOGLE_ADS_LEAD_CONVERSION_LABEL="abcDEFghijkLMnopQRsT"
VITE_META_PIXEL_ID="1234567890"

# Optional paid-media account metadata for operator docs/readiness checks.
# These values do not enable account mutation or spend by themselves.
GOOGLE_ADS_CUSTOMER_ID="1234567890"
GOOGLE_ADS_CONVERSION_ACTION="Book a call lead"
META_AD_ACCOUNT_ID="act_1234567890"
META_PIXEL_ID="1234567890"

# Deployment environments:
# - Local development values live in .env.local.
# - Staging values live in the Vercel staging target or staging branch preview vars.
# - Production values live only in Vercel production vars.
# Never commit real secrets or generated .env files.
